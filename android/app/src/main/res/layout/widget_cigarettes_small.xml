<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Sigarette" in formato basso (2×1): icona in alto, poi − numero + sulla stessa riga.
  Solo viste ammesse nei widget (LinearLayout, TextView, ImageView): niente View o Space.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_cigarette" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_cig_title"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cig_minus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_cig_minus"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="−"
            android:textColor="@color/widget_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/cig_count"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/widget_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cig_plus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn_accent"
            android:contentDescription="@string/widget_cig_plus"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/widget_on_accent"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
